{
  "name": "skillswap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --conditions=react-server --env-file=.env.local --import tsx server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:u": "vitest run --project unit",
    "test:i": "vitest run --project integration",
    "test:watch": "vitest watch",
    "check": "pnpm run typecheck && pnpm run test",
    "seed:dev": "node --conditions=react-server --env-file=.env --import tsx scripts/seed.ts --profile=dev",
    "seed:demo": "node --conditions=react-server --env-file=.env --import tsx scripts/seed.ts --profile=demo"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.20",
    "mongoose": "^9.11.3",
    "next": "16.4.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
