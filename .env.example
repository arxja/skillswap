# ─── Server ─────────────────────────────────────────────
# Local dev:
DATABASE_URL="mongodb://localhost:27017/myapp"
# Atlas / SRV form:
# DATABASE_URL="mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/myapp?retryWrites=true&w=majority"

NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# ─── Client ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="My App"
NEXT_PUBLIC_API_URL="/api"